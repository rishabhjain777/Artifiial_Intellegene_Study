# Meta WhatsApp Cloud API Configuration whatsapp_cloud_api.py
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Chatbot telegram token and telegram chat id for telegram_cloud_api.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free Airtel / Local SIM SMS Dispatcher Configuration
# Providers: 'gateway' (Android app / Termux on Wi-Fi), 'adb' (USB cable), or 'modem' (4G USB Dongle)
SMS_PROVIDER=gateway
SMS_GATEWAY_URL=http://192.168.1.15:8080
SMS_GATEWAY_TOKEN=
SMS_SIM_SLOT=1
SMS_MAX_DAILY=95
SMS_COOLDOWN_SECONDS=5.0
# Brevo Transactional Email Configuration api_brevo.py
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-verified-sender@yourdomain.com
BREVO_SENDER_NAME=Your App Name
